{
  "Defaults": {
    "Scheme": "https",
    "Port": 0,
    "SkipCertificateCheck": false,
    "TimeoutSec": 60,
    "AuthMode": "ApiKey",
    "Domain": "LOCAL",
    "OutputDirectory": "reports",
    "RetentionDays": 30,
    "TextfileDirectory": "metrics",
    "StateDirectory": "state",
    "CollectAlerts": true,
    "AlertLogDirectory": "events",
    "AlertLogRetentionDays": 90,
    "DisabledChecks": []
  },
  "Servers": [
    {
      "Name": "COHESITY-01",
      "Host": "cohesity-01.example.com",
      "AuthMode": "ApiKey",
      "CredentialFile": "creds\\cohesity-01.xml"
    },
    {
      "Name": "COHESITY-02",
      "Host": "192.0.2.12",
      "AuthMode": "Password",
      "Domain": "LOCAL",
      "SkipCertificateCheck": false,
      "CredentialFile": "creds\\cohesity-02.xml"
    }
  ]
}
