{
  "title": "Cohesity Fleet",
  "uid": "cohesity-fleet",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "cohesity"
  ],
  "description": "One row per cluster; red rows need attention. Click a cluster name to open its Instance page.",
  "links": [
    {
      "title": "Cohesity dashboards",
      "type": "dashboards",
      "tags": [
        "cohesity"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {
          "text": "Cohesity Prometheus",
          "value": "cohesity-prometheus"
        }
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(cohesity_up, cluster)",
          "refId": "A"
        },
        "definition": "label_values(cohesity_up, cluster)",
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "label": "Cluster"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "id": 1,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "transparent": true,
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;gap:18px;height:48px;box-sizing:border-box;padding:0 18px;border-radius:6px;background:linear-gradient(90deg,#141A26 0%,#1E2738 100%);border-left:4px solid #3D71D9\"><!--logo--><div style=\"min-width:0;color:#8AB8FF;font-size:15px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\"><!--brand-->Cohesity monitoring<!--/brand--> &middot; <!--version-->v1.0.0<!--/version--></div></div>"
      }
    },
    {
      "type": "marcusolsson-dynamictext-panel",
      "title": "",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "transparent": true,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "label_replace(count(cohesity_up{cluster=~\"$cluster\"}), \"k\", \"clusters\", \"\", \"\") or label_replace(count(cohesity_up{cluster=~\"$cluster\"} == 0) or vector(0), \"k\", \"api_down\", \"\", \"\") or label_replace(count(cohesity_check_success{cluster=~\"$cluster\"} == 0) or vector(0), \"k\", \"checks\", \"\", \"\") or label_replace(count(cohesity_group_last_run_ok{cluster=~\"$cluster\"} == 0) or vector(0), \"k\", \"groups\", \"\", \"\") or label_replace(sum(cohesity_group_last_run_sla_violated{cluster=~\"$cluster\"}) or vector(0), \"k\", \"sla\", \"\", \"\") or label_replace(sum(cohesity_alerts_open{cluster=~\"$cluster\",severity=\"critical\"}) or vector(0), \"k\", \"critical\", \"\", \"\") or label_replace((count(cohesity_node_in_cluster{cluster=~\"$cluster\"} == 0) or vector(0)) + (sum(cohesity_node_offline_disks{cluster=~\"$cluster\"}) or vector(0)), \"k\", \"hardware\", \"\", \"\") or label_replace(time() - cohesity_collector_last_run_timestamp_seconds, \"k\", \"lastrun\", \"\", \"\")",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "renderMode": "allRows",
        "content": "{{{cohesityCards data}}}",
        "defaultContent": "<div class=\"ss-section\"><div class=\"ss-head\">Estate</div><div class=\"ss\"><div class=\"ss-hero unknown\"><div class=\"ss-mark\">?</div><div class=\"ss-hero-title\">No data</div><div class=\"ss-hero-sub\">Prometheus returned nothing for the estate cards.</div></div></div></div>",
        "helpers": "const CARDS = [{\"k\": \"clusters\", \"label\": \"Clusters\", \"unit\": null, \"warn\": null, \"crit\": null}, {\"k\": \"api_down\", \"label\": \"API down\", \"unit\": null, \"warn\": null, \"crit\": 1}, {\"k\": \"checks\", \"label\": \"Failed checks\", \"unit\": null, \"warn\": null, \"crit\": 1}, {\"k\": \"groups\", \"label\": \"Groups failing\", \"unit\": null, \"warn\": null, \"crit\": 1}, {\"k\": \"sla\", \"label\": \"SLA violations\", \"unit\": null, \"warn\": 1, \"crit\": null}, {\"k\": \"critical\", \"label\": \"Critical alerts open\", \"unit\": null, \"warn\": null, \"crit\": 1}, {\"k\": \"hardware\", \"label\": \"Nodes out / disks offline\", \"unit\": null, \"warn\": 1, \"crit\": null}, {\"k\": \"lastrun\", \"label\": \"Collector last run\", \"unit\": \"s\", \"warn\": 600, \"crit\": 900}];\nconst TITLE = \"Estate\";\nconst num = (row) => {\n  for (const key of Object.keys(row)) {\n    if (key.indexOf('Value') === 0) { return Number(row[key]); }\n  }\n  return NaN;\n};\nconst esc = (s) => String(s).replace(/[&<>\"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' })[ch]);\nconst fmt = (v, unit) => {\n  if (!isFinite(v)) { return '-'; }\n  if (unit === 's') {\n    if (v < 90) { return Math.round(v) + ' s'; }\n    if (v < 5400) { return (v / 60).toFixed(1) + ' min'; }\n    return (v / 3600).toFixed(1) + ' h';\n  }\n  return String(Math.round(v));\n};\nconst level = (v, c) => {\n  if (!isFinite(v)) { return 'unknown'; }\n  if (c.crit !== null && v >= c.crit) { return 'critical'; }\n  if (c.warn !== null && v >= c.warn) { return 'warning'; }\n  return c.crit === null && c.warn === null ? 'info' : 'ok';\n};\nconst WORD = { ok: 'OK', warning: 'Check', critical: 'Action', info: 'Info', unknown: 'No data' };\ncontext.handlebars.registerHelper('cohesityCards', (rows) => {\n  const values = {};\n  (rows || []).forEach((row) => { values[row.k] = num(row); });\n  let attention = 0;\n  let worst = 'ok';\n  const tiles = CARDS.map((c) => {\n    const v = values[c.k];\n    const lv = level(v, c);\n    if (lv === 'critical' || lv === 'warning' || lv === 'unknown') { attention += 1; }\n    if (lv === 'critical' || (lv !== 'ok' && lv !== 'info' && worst === 'ok')) { worst = lv; }\n    return '<div class=\"ss-card ' + lv + '\"><div class=\"ss-label\" title=\"' + esc(c.label) + '\">' + esc(c.label) + '</div>' +\n      '<div class=\"ss-value\">' + esc(fmt(v, c.unit)) + '</div><div class=\"ss-pill\">' + WORD[lv] + '</div></div>';\n  }).join('');\n  const total = values.clusters;\n  const down = values.api_down;\n  const reach = isFinite(total) && isFinite(down) ? (total - down) + ' of ' + total + ' clusters reachable' : 'Cluster count not available';\n  const title = attention === 0 ? 'All clusters healthy' : attention + (attention === 1 ? ' indicator needs' : ' indicators need') + ' attention';\n  const mark = attention === 0 ? '&#10003;' : '!';\n  const hero = '<div class=\"ss-hero ' + (attention === 0 ? 'ok' : worst) + '\"><div class=\"ss-mark\">' + mark + '</div>' +\n    '<div class=\"ss-hero-title\">' + esc(title) + '</div><div class=\"ss-hero-sub\">' + esc(reach) + '</div></div>';\n  return new context.handlebars.SafeString('<div class=\"ss-section\"><div class=\"ss-head\">' + esc(TITLE) + '</div>' +\n    '<div class=\"ss\">' + hero + tiles + '</div></div>');\n});\n",
        "styles": ".ss-section { display: flex; flex-direction: column; height: 100%; box-sizing: border-box; border-radius: 18px; overflow: hidden;\n  background: #141A26; border: 1px solid #1E2738; }\n.ss-head { flex: none; display: flex; align-items: center; gap: 10px; height: 36px; padding: 0 18px; border-radius: 18px;\n  background: linear-gradient(90deg, #1E2738 0%, #141A26 100%); color: #8AB8FF; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; }\n.ss { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(240px, 1.4fr) repeat(4, minmax(140px, 1fr)); grid-auto-rows: 1fr; gap: 10px; padding: 10px 12px 12px; }\n.ss-hero { grid-row: span 2; display: flex; flex-direction: column; justify-content: center; gap: 6px; padding: 16px 20px; border-radius: 14px;\n  background: linear-gradient(135deg, #141A26 0%, #1E2738 100%); border-left: 4px solid #3D71D9; }\n.ss-mark { width: 44px; height: 44px; border-radius: 50%; border: 3px solid currentColor; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 700; }\n.ss-hero-title { font-size: 22px; font-weight: 700; line-height: 1.2; }\n.ss-hero-sub { color: #A3ACB9; font-size: 13px; }\n.ss-card { display: flex; flex-direction: column; justify-content: space-between; gap: 4px; min-width: 0; padding: 10px 14px; border-radius: 14px;\n  background: #1E2738; border-top: 3px solid #5794F2; }\n.ss-label { color: #8AB8FF; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.ss-value { color: #FFFFFF; font-size: 32px; font-weight: 700; line-height: 1.1; }\n.ss-pill { align-self: flex-start; padding: 2px 9px; border-radius: 10px; color: #FFFFFF; font-size: 11px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; }\n.ss-hero.ok { color: #73BF69; } .ss-hero.warning { color: #FF9830; } .ss-hero.critical { color: #F2495C; } .ss-hero.unknown { color: #A3ACB9; }\n.ss-hero .ss-hero-title { color: #FFFFFF; }\n.ss-card.ok { border-top-color: #73BF69; } .ss-card.ok .ss-pill { background: #73BF69; }\n.ss-card.info .ss-pill { background: #5794F2; }\n.ss-card.warning { border-top-color: #FF9830; background: linear-gradient(180deg, #FF983040 0%, #1E2738 70%); } .ss-card.warning .ss-pill { background: #FF9830; }\n.ss-card.critical { border-top-color: #F2495C; background: linear-gradient(180deg, #F2495C40 0%, #1E2738 70%); } .ss-card.critical .ss-pill { background: #F2495C; }\n.ss-card.unknown { border-top-color: #A3ACB9; } .ss-card.unknown .ss-pill { background: #A3ACB9; color: #141A26; }\n",
        "wrap": false,
        "editors": [
          "helpers",
          "styles"
        ],
        "editor": {
          "format": "auto",
          "language": "html"
        },
        "contentPartials": [],
        "externalStyles": [],
        "afterRender": "",
        "status": ""
      },
      "description": "Estate health at a glance. A tile turns orange or red at the same thresholds as the stat row of the plain Fleet dashboard; 'Groups failing' counts protection groups whose last backup run failed; 'Collector last run' is the time since the collector last completed a full run."
    },
    {
      "type": "text",
      "title": "",
      "id": 4,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "transparent": true,
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:flex-end;width:100%;height:100%\"><div style=\"display:flex;align-items:center;gap:10px;width:100%;box-sizing:border-box;height:36px;padding:0 18px;border-radius:999px;background:linear-gradient(90deg,#1E2738 0%,#141A26 100%);border:1px solid #1E2738\"><span style=\"color:#8AB8FF;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">Clusters</span></div></div>"
      }
    },
    {
      "type": "table",
      "title": "Fleet status",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (cluster) (cohesity_up{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (cluster) (1 - cohesity_check_success{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "100 * max by (cluster) (cohesity_storage_used_bytes{cluster=~\"$cluster\"}) / max by (cluster) (cohesity_storage_capacity_bytes{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "max by (cluster) (cohesity_cluster_data_reduction_ratio{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "E",
          "expr": "sum by (cluster) (1 - cohesity_group_last_run_ok{cluster=~\"$cluster\"}) or 0 * max by (cluster) (cohesity_up{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "F",
          "expr": "sum by (cluster) (cohesity_group_last_run_sla_violated{cluster=~\"$cluster\"}) or 0 * max by (cluster) (cohesity_up{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "G",
          "expr": "sum by (cluster) (cohesity_group_runs_24h{cluster=~\"$cluster\",status=\"failed\"}) or 0 * max by (cluster) (cohesity_up{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "H",
          "expr": "max by (cluster) (cohesity_runs_active{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "I",
          "expr": "sum by (cluster) (cohesity_alerts_open{cluster=~\"$cluster\",severity=\"critical\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "J",
          "expr": "sum by (cluster) (cohesity_alerts_open{cluster=~\"$cluster\",severity=\"warning\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "K",
          "expr": "(count by (cluster) (cohesity_node_in_cluster{cluster=~\"$cluster\"} == 0) or 0 * max by (cluster) (cohesity_up{cluster=~\"$cluster\"})) + (sum by (cluster) (cohesity_node_offline_disks{cluster=~\"$cluster\"}) or 0 * max by (cluster) (cohesity_up{cluster=~\"$cluster\"}))",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "L",
          "expr": "max by (cluster) (cohesity_cluster_stopped_services{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "M",
          "expr": "max by (cluster) (abs(cohesity_time_offset_seconds{cluster=~\"$cluster\"}))",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "N",
          "expr": "max by (cluster, version) (cohesity_info{cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Clock offset"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reduction"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "API"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "OK",
                        "color": "green"
                      },
                      "0": {
                        "text": "FAIL",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Used %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cluster"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open instance",
                    "url": "/d/cohesity-instance/cohesity-instance?var-cluster=${__data.fields.cluster}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "pattern": "^(__name__|Time)$"
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "instance": true,
              "job": true,
              "Time": true,
              "Value #N": true
            },
            "renameByName": {
              "Value #A": "API",
              "Value #B": "Failed checks",
              "Value #C": "Used %",
              "Value #D": "Reduction",
              "Value #E": "Groups failing",
              "Value #F": "SLA missed",
              "Value #G": "Failed runs 24h",
              "Value #H": "Running",
              "Value #I": "Critical alerts",
              "Value #J": "Warning alerts",
              "Value #K": "Nodes/disks out",
              "Value #L": "Stopped services",
              "Value #M": "Clock offset"
            },
            "indexByName": {
              "cluster": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9,
              "Value #J": 10,
              "Value #K": 11,
              "Value #L": 12,
              "Value #M": 13,
              "version": 14
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Failed checks",
                "desc": true
              }
            ]
          }
        }
      ],
      "description": "Used % is local storage used / total capacity (v2 cluster-storage). Reduction is the cluster data reduction ratio (N:1). Groups failing counts groups whose last backup run failed; SLA missed counts groups whose last run missed its SLA. Nodes/disks out adds nodes not in the cluster and offline disks."
    },
    {
      "type": "text",
      "title": "",
      "id": 6,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "transparent": true,
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:flex-end;width:100%;height:100%\"><div style=\"display:flex;align-items:center;gap:10px;width:100%;box-sizing:border-box;height:36px;padding:0 18px;border-radius:999px;background:linear-gradient(90deg,#1E2738 0%,#141A26 100%);border:1px solid #1E2738\"><span style=\"color:#8AB8FF;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">Trends</span></div></div>"
      }
    },
    {
      "type": "timeseries",
      "title": "Storage used %",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "100 * cohesity_storage_used_bytes{cluster=~\"$cluster\"} / cohesity_storage_capacity_bytes{cluster=~\"$cluster\"}",
          "legendFormat": "{{cluster}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Cluster throughput (read + write)",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
