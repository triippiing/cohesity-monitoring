              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*(error|fail|stopped|missed|canceled|cancelled|unregister|infected|critical).*",
                      "result": {
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*(running|accepted|onhold|paused|finalizing|canceling|warning|pending|scheduled|refresh|quarantin).*",
                      "result": {
                        "color": "orange"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(succeeded|registered|finished|none|dontremove|ok|healthy)$",
                      "result": {
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "instance": true,
              "job": true,
              "Time": true
            },
            "renameByName": {
              "Value": "Alerts"
            },
            "indexByName": {
              "cluster": 0,
              "bucket": 1,
              "severity": 2,
              "Value": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Alerts",
                "desc": true
              }
            ]
          }
        }
      ],
      "description": "From v1 stats/alerts: hardware, software, data service and maintenance alerts."
    }
  ]
}